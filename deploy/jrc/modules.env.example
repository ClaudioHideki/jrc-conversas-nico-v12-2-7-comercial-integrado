# Copy values into Dokploy Environment. Never commit the populated copy.
# Replace REVISION with the SAME full Git commit SHA in both image tags.
JRC_APP_IMAGE=ghcr.io/claudiohideki/jrc-conversas-nico-v12-2-7-comercial-integrado:sha-REVISION
JRC_FLOWS_SANDBOX_IMAGE=ghcr.io/claudiohideki/jrc-conversas-nico-v12-2-7-comercial-integrado-flows-sandbox:sha-REVISION
# Enable after migration and account-level configuration.
JRC_FLOWS_ENABLED=false
JRC_BROKER_ENABLED=false
JRC_BROKER_ALLOWED_ORIGINS=https://broker.example.com
# Independent generated values, persisted across deploys. No real keys in Git.
JRC_BROKER_CREDENTIAL_KEY=
JRC_FLOWS_SANDBOX_TOKEN=
